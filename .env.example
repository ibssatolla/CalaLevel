# Copy to .env and fill in. Then run:  node scripts/write-env.mjs
# Both values are PUBLIC (they end up in js/env.js, which the browser downloads). Row Level Security protects the data.
# NEVER put the service_role key, a database password or any other secret in this file or in js/env.js.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
